{
  "openapi": "3.0.4",
  "info": {
    "title": "CRM Admin API",
    "version": "v1"
  },
  "paths": {
    "/api/Admin/Diagnostics/throw": {
      "get": {
        "tags": [
          "Diagnostics"
        ],
        "summary": "500 - the body must contain neither the message nor the fake connection string.",
        "responses": {
          "500": {
            "description": "Internal Server Error",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/Admin/Diagnostics/credentials": {
      "post": {
        "tags": [
          "Diagnostics"
        ],
        "summary": "204 - the log must show every secret-named value as \"***\".",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DiagnosticsCredentials"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/DiagnosticsCredentials"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/DiagnosticsCredentials"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "No Content"
          }
        }
      }
    },
    "/api/Admin/Diagnostics/forbidden": {
      "get": {
        "tags": [
          "Diagnostics"
        ],
        "responses": {
          "403": {
            "description": "Forbidden",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/Admin/Diagnostics/unauthorized": {
      "get": {
        "tags": [
          "Diagnostics"
        ],
        "responses": {
          "401": {
            "description": "Unauthorized",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/Admin/Diagnostics/unstable": {
      "get": {
        "tags": [
          "Diagnostics"
        ],
        "summary": "The endpoint that fails on demand: 503 when fail, otherwise 200.",
        "parameters": [
          {
            "name": "fail",
            "in": "query",
            "schema": {
              "type": "boolean",
              "default": true
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "503": {
            "description": "Service Unavailable"
          }
        }
      }
    },
    "/api/Admin/Diagnostics/outbound": {
      "get": {
        "tags": [
          "Diagnostics"
        ],
        "summary": "Calls M:Crm.Api.Diagnostics.Admin.DiagnosticsController.Unstable(System.Boolean) through the resilient client: retries, then an open circuit.",
        "parameters": [
          {
            "name": "fail",
            "in": "query",
            "schema": {
              "type": "boolean",
              "default": true
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/OutboundResult"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OutboundResult"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/OutboundResult"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/Admin/Samples": {
      "post": {
        "tags": [
          "Samples"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateSampleRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateSampleRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/CreateSampleRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/SampleAggregateDto"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SampleAggregateDto"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/SampleAggregateDto"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblemDetails"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblemDetails"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/Admin/Samples/{id}": {
      "get": {
        "tags": [
