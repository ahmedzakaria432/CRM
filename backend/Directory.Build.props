<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsAsErrors />
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591: missing XML doc comment - GenerateDocumentationFile is on so analyzers see doc -->
    <!-- comments, but requiring one on every public member would bury real warnings. -->
    <!-- CA1716: "Error"/"Result" collide with reserved words in VB/F#. This is a private, -->
    <!-- C#-only backend with no cross-language public surface, and Error/Result/Result<T> is the -->
    <!-- exact vocabulary CLAUDE.md mandates - renaming it to dodge a multi-language-library rule -->
    <!-- would be worse than suppressing the rule. -->
    <NoWarn>$(NoWarn);CS1591;CA1716</NoWarn>
  </PropertyGroup>

  <!-- "Pure" projects carry no infrastructure at all: the shared kernel, every module's Domain, and -->
  <!-- every module's Contracts. They get the stricter banned-API list below. -->
  <PropertyGroup>
    <CrmIsPureProject Condition="'$(MSBuildProjectName)' == 'Crm.SharedKernel' or $(MSBuildProjectName.EndsWith('.Domain')) or $(MSBuildProjectName.EndsWith('.Contracts'))">true</CrmIsPureProject>
  </PropertyGroup>

  <!-- The banned-API analyzer and its lists are wired here once, for every project, so a new -->
  <!-- module project cannot forget them. BannedApiAnalyzers reads every BannedSymbols.*.txt it is given. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)build/BannedSymbols.Clock.txt" />
    <!-- SystemDateTime, the one IDateTime implementation, lives in Crm.BuildingBlocks.Infrastructure. -->
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)build/BannedSymbols.TimeProvider.txt" Condition="'$(MSBuildProjectName)' != 'Crm.BuildingBlocks.Infrastructure'" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)build/BannedSymbols.Pure.txt" Condition="'$(CrmIsPureProject)' == 'true'" />
  </ItemGroup>
</Project>
