@host = http://localhost:5187

# Story 15 - the Tickets module: ticket aggregate, status machine, assignment (claim, assign, unassign, transfer), categories,
# queues and search. Run top to bottom against a Development API (`docker compose up -d`, then
# `dotnet run --project backend/src/Crm.Api --launch-profile http`).
# Dev seed (Crm.Modules.Tickets.Contracts.DevSeed.TicketsDevSeed): T-000001 Ahmed (RYD-CARE, New, unassigned), T-000002 Najd
# (RYD-CARE, Open, assigned to agent A), T-000003 Red Sea (JED-CARE, New, Urgent - invisible to agent A). On a fresh database the
# seed takes T-000001..T-000003, so request 12 is T-000004. Request 55 creates department RYD-TKT; on a second run it answers
# 409 Organisation.DepartmentCodeTaken - skip 55a.
# Access tokens live 2 minutes in Development - re-run the logins when a request answers 401. Sign-in is limited to 30/min.
# rowVersion is base64: always send the value the LAST response returned (the requests below chain it with `# @name`).
# Every ticket is organisation-scoped (Story 06): an existing out-of-scope id is 403 Organisation.OutOfScope, an unknown id 404.

@ryCare = 06000000-0000-0000-0002-000000000001
@ryBill = 06000000-0000-0000-0002-000000000002
@jeCare = 06000000-0000-0000-0002-000000000003
@riyadhBranch = 06000000-0000-0000-0001-000000000001
@ahmed = 11000000-0000-0000-0000-000000000001
@najd = 11000000-0000-0000-0000-000000000002
@redSea = 11000000-0000-0000-0000-000000000003
@ahmedContact = 11000000-0000-0000-0001-000000000001
@saraContact = 11000000-0000-0000-0001-000000000002
@agentA = 06000000-0000-0000-0003-000000000003
@agentB = 06000000-0000-0000-0003-000000000004
@ryCareGeneral = 15000000-0000-0000-0001-000000000001
@ryCareTechnical = 15000000-0000-0000-0001-000000000002
@ryCareComplaint = 15000000-0000-0000-0001-000000000003
@ryCareInternal = 15000000-0000-0000-0001-000000000004
@ryCareLegacy = 15000000-0000-0000-0001-000000000005
@ryBillInvoice = 15000000-0000-0000-0001-000000000006
@jeCareGeneral = 15000000-0000-0000-0001-000000000007
@ahmedNewTicket = 15000000-0000-0000-0000-000000000001
@najdOpenTicket = 15000000-0000-0000-0000-000000000002
@redSeaNewTicket = 15000000-0000-0000-0000-000000000003
@unknown = 00000000-0000-0000-0000-00000000dead

### Login as agent A (Agent in RYD-CARE)
# @name loginAgentA
POST {{host}}/api/Agent/Auth/login
Content-Type: application/json

{ "email": "agent.a@crm.local", "password": "Crm_Dev_2026!" }

@agentAToken = {{loginAgentA.response.body.accessToken}}

### Login as agent B (Agent in JED-CARE)
# @name loginAgentB
POST {{host}}/api/Agent/Auth/login
Content-Type: application/json

{ "email": "agent.b@crm.local", "password": "Crm_Dev_2026!" }

@agentBToken = {{loginAgentB.response.body.accessToken}}

### Login as supervisor (Supervisor in RYD-CARE, Agent in RYD-BILL)
# @name loginSupervisor
POST {{host}}/api/Agent/Auth/login
Content-Type: application/json

{ "email": "supervisor@crm.local", "password": "Crm_Dev_2026!" }

@supervisorToken = {{loginSupervisor.response.body.accessToken}}

### Login as administrator
# @name loginAdmin
POST {{host}}/api/Agent/Auth/login
Content-Type: application/json

{ "email": "admin@crm.local", "password": "Crm_Dev_2026!" }

@adminToken = {{loginAdmin.response.body.accessToken}}

###############################################################################################################################
### Categories
###############################################################################################################################

### 1. Admin: RYD-CARE categories - 200: five, including the inactive Legacy, ordered by displayOrder
GET {{host}}/api/Admin/TicketCategories?departmentId={{ryCare}}
Authorization: Bearer {{adminToken}}

### 2. Admin: active only - 200: Legacy absent
GET {{host}}/api/Admin/TicketCategories?departmentId={{ryCare}}&activeOnly=true
Authorization: Bearer {{adminToken}}

### 3. Admin: create a category - 200 (@refund)
# @name refund
POST {{host}}/api/Admin/TicketCategories
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{ "departmentId": "{{ryCare}}", "nameAr": "استرداد", "nameEn": "Refund", "displayOrder": 50, "isCustomerVisible": true }

@refundId = {{refund.response.body.id}}

### 4a. Admin: empty Arabic name - 400 urn:crm:problem:validation: errors.NameAr
POST {{host}}/api/Admin/TicketCategories
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{ "departmentId": "{{ryCare}}", "nameAr": "", "nameEn": "Refund", "displayOrder": 50, "isCustomerVisible": true }

### 4b. Admin: display order 10000 - 400: errors.DisplayOrder
POST {{host}}/api/Admin/TicketCategories
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{ "departmentId": "{{ryCare}}", "nameAr": "استرداد", "nameEn": "Refund", "displayOrder": 10000, "isCustomerVisible": true }

### 5. Admin: unknown department - 404 Organisation.DepartmentNotFound
POST {{host}}/api/Admin/TicketCategories
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{ "departmentId": "{{unknown}}", "nameAr": "استرداد", "nameEn": "Refund", "displayOrder": 50, "isCustomerVisible": true }

### 6a. Admin: rename with the current rowVersion - 200
# @name refundRenamed
PUT {{host}}/api/Admin/TicketCategories/{{refundId}}
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{ "nameAr": "المبالغ المستردة", "nameEn": "Refunds", "displayOrder": 55, "isCustomerVisible": true, "rowVersion": "{{refund.response.body.rowVersion}}" }

### 6b. Admin: stale rowVersion - 409 Persistence.ConcurrencyConflict
PUT {{host}}/api/Admin/TicketCategories/{{refundId}}
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{ "nameAr": "المبالغ المستردة", "nameEn": "Refunds", "displayOrder": 55, "isCustomerVisible": true, "rowVersion": "AAAAAAAAB9E=" }

### 7a. Admin: deactivate - 200 isActive: false
# @name refundOff
POST {{host}}/api/Admin/TicketCategories/{{refundId}}/deactivate
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{ "rowVersion": "{{refundRenamed.response.body.rowVersion}}" }

### 7b. Admin: deactivate again - 422 Tickets.CategoryAlreadyInactive
POST {{host}}/api/Admin/TicketCategories/{{refundId}}/deactivate
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{ "rowVersion": "{{refundOff.response.body.rowVersion}}" }

### 7c. Admin: reactivate - 200 isActive: true
# @name refundOn
POST {{host}}/api/Admin/TicketCategories/{{refundId}}/reactivate
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{ "rowVersion": "{{refundOff.response.body.rowVersion}}" }

### 7d. Admin: reactivate again - 422 Tickets.CategoryAlreadyActive
POST {{host}}/api/Admin/TicketCategories/{{refundId}}/reactivate
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{ "rowVersion": "{{refundOn.response.body.rowVersion}}" }

### 8. Agent A on the admin endpoint - 403 naming admin.organisation
GET {{host}}/api/Admin/TicketCategories
Authorization: Bearer {{agentAToken}}

### 9. Agent picker for RYD-CARE - 200: active only (no Legacy), both name languages
GET {{host}}/api/Agent/TicketCategories?departmentId={{ryCare}}
Authorization: Bearer {{agentAToken}}

### 10. Agent picker without a filter - 200: RYD-CARE categories only (agent A's scope)
GET {{host}}/api/Agent/TicketCategories
Authorization: Bearer {{agentAToken}}

### 11. Same in Arabic - 200: identical body (culture-neutral)
GET {{host}}/api/Agent/TicketCategories
Authorization: Bearer {{agentAToken}}
Accept-Language: ar

###############################################################################################################################
### Create
###############################################################################################################################

### 12. Create a ticket for Ahmed - 200 (@t1): number T-000004 on a fresh DB, status New, one Created activity, allowedActions has
### Open, Resolve, Cancel, Claim, Assign but not Close/Unassign. EF log: SELECT NEXT VALUE FOR [tickets].[TicketNumbers] between
### BEGIN TRANSACTION and INSERT INTO [tickets].[Tickets]; one INSERT INTO [tickets].[outbox_messages].
# @name t1
POST {{host}}/api/Agent/Tickets
Content-Type: application/json
Authorization: Bearer {{agentAToken}}

{
  "customerId": "{{ahmed}}",
  "contactId": "{{ahmedContact}}",
  "subject": "طلب استرداد مبلغ",
  "description": "أرغب في استرداد المبلغ المدفوع عن الطلب الأخير.",
  "priority": "High",
  "categoryId": "{{ryCareGeneral}}"
}

@t1Id = {{t1.response.body.id}}

### 13. Create for Red Sea (JED-CARE) as agent A - 403 Organisation.OutOfScope
POST {{host}}/api/Agent/Tickets
Content-Type: application/json
Authorization: Bearer {{agentAToken}}

{ "customerId": "{{redSea}}", "subject": "Out of scope", "description": "Should be refused." }

