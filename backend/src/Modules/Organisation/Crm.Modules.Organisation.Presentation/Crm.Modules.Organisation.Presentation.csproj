<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Hides the module's Domain assembly from the controllers: without this, Domain types flow in -->
    <!-- transitively through the Application reference and could cross the API boundary unnoticed. -->
    <!-- Every project a controller compiles against must therefore be referenced directly below. -->
    <DisableTransitiveProjectReferences>true</DisableTransitiveProjectReferences>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\BuildingBlocks\Crm.SharedKernel\Crm.SharedKernel.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks\Crm.BuildingBlocks.Application\Crm.BuildingBlocks.Application.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks\Crm.BuildingBlocks.Presentation\Crm.BuildingBlocks.Presentation.csproj" />
    <ProjectReference Include="..\Crm.Modules.Organisation.Application\Crm.Modules.Organisation.Application.csproj" />
  </ItemGroup>

</Project>
