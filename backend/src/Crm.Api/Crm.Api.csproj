<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- The host: composition root only. It references each module through that module's -->
  <!-- Infrastructure (services, DbContext) and Presentation (controllers) projects and nothing else - -->
  <!-- Directory.Build.targets rule 7. Register a new module in Modules/ModuleCatalog.cs. -->

  <ItemGroup>
    <ProjectReference Include="..\BuildingBlocks\Crm.BuildingBlocks.Infrastructure\Crm.BuildingBlocks.Infrastructure.csproj" />
    <ProjectReference Include="..\BuildingBlocks\Crm.BuildingBlocks.Presentation\Crm.BuildingBlocks.Presentation.csproj" />
    <ProjectReference Include="..\Modules\Organisation\Crm.Modules.Organisation.Infrastructure\Crm.Modules.Organisation.Infrastructure.csproj" />
    <ProjectReference Include="..\Modules\Organisation\Crm.Modules.Organisation.Presentation\Crm.Modules.Organisation.Presentation.csproj" />
    <ProjectReference Include="..\Modules\Sample\Crm.Modules.Sample.Infrastructure\Crm.Modules.Sample.Infrastructure.csproj" />
    <ProjectReference Include="..\Modules\Sample\Crm.Modules.Sample.Presentation\Crm.Modules.Sample.Presentation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" />
    <!-- The EF Core CLI tools require the startup project itself to carry this reference, even -->
    <!-- though every module DbContext lives in that module's Infrastructure project. Build-time only. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
